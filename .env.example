NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Set in your local/deployment environment, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared password for the counseling-center access screen. Keep this server-only.
# Set SITE_ACCESS_ENABLED=false to turn off the password gate without deleting the password.
SITE_ACCESS_ENABLED=true
SITE_ACCESS_PASSWORD=choose-a-private-password
# Optional random signing secret. If omitted, the password is used as the signing secret.
SITE_ACCESS_SECRET=replace-with-a-long-random-secret
